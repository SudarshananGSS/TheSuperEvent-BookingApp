<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CartController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <center>
        <TableView fx:id="cartTable">
            <columns>

                <TableColumn fx:id="titleCol" text="Event" />
                <TableColumn fx:id="venueCol" text="Venue" />
                <TableColumn fx:id="dayCol" text="Day" />
                <TableColumn fx:id="priceCol" text="Price" />
                <TableColumn fx:id="availableCol" text="Available Tickets" />
                <TableColumn fx:id="quantityCol" text="Quantity" />
                <TableColumn fx:id="totalPriceCol" text="Total Price" />
                <TableColumn fx:id="statusCol" text="Status" />

            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10">
            <Button fx:id="removeButton" onAction="#handleRemove" text="Remove" />
            <Label fx:id="statusLabel" />
            <Button fx:id="checkoutButton" onAction="#handleCheckout" text="Checkout and Pay">
                <tooltip><Tooltip text="Proceed to payment"/></tooltip>
            </Button>
            <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh Cart" />
            <Button fx:id="backButton" onAction="#handleBack" text="Back" />
            <Label fx:id="totalPriceLabel" alignment="CENTER_RIGHT" prefHeight="29.0" prefWidth="259.0" text="Total: $0.00">
            <padding>
               <Insets right="50.0" />
            </padding></Label>
        </HBox>
    </bottom>
</BorderPane>
