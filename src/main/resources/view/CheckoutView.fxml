<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<VBox alignment="CENTER" prefHeight="290.0" prefWidth="345.0" spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="controller.CheckoutController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Enter Confirmation Code (6 digits)" />
    <TextField fx:id="confirmationCodeField" prefHeight="25.0" prefWidth="224.0" promptText="123456" />
    <Label fx:id="statusLabel" />
    <Button fx:id="confirmButton" onAction="#handleConfirm" text="Confirm Order">
        <tooltip><Tooltip text="Submit and pay"/></tooltip>
    </Button>
   <Button onAction="#handleBack" text="Cancel" />
</VBox>
